    },
    {
      "id": "00000000-0000-4000-8000-000000000130",
      "name": "Mascarar erro",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst msg = String(e.execution?.error?.message || '').replace(/[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+/g, '[EMAIL]').replace(/\\d{8,}/g, '[NUM]').slice(0, 300);\nreturn [{ json: { origem: 'n8n', workflow: e.workflow?.name || null, no: e.execution?.lastNodeExecuted || null, codigo: e.execution?.error?.name || 'erro', mensagem: msg, correlacao: String(e.execution?.id || '') } }];"
      }
    },
