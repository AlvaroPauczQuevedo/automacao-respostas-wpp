    {
      "id": "00000000-0000-4000-8000-000000000099",
      "name": "Validar ferramenta do domínio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const PERMITIDAS = [\"encaminhar_atendimento\"];\nconst i = $input.first().json;\nif (!PERMITIDAS.includes(i.ferramenta)) throw new Error('Ferramenta fora da lista permitida deste domínio');\nif (typeof i.turno_id !== 'string' || !/^turno_[A-Za-z0-9_-]{6,40}$/.test(i.turno_id)) throw new Error('turno_id inválido');\n// Alguns modelos enviam o objeto como texto JSON.\nlet args = i.argumentos;\nif (typeof args === 'string') { try { args = JSON.parse(args); } catch { args = {}; } }\nif (!args || typeof args !== 'object' || Array.isArray(args)) args = {};\nreturn [{ json: { ferramenta: i.ferramenta, turno_id: i.turno_id, argumentos: args } }];"
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000100",
      "name": "Core: executar ferramenta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
