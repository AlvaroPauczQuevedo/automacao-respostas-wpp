      "parameters": {
        "method": "POST",
        "url": "=http://core:8080/internal/ferramentas/{{ $json.ferramenta }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-turno-id",
              "value": "={{ $json.turno_id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.argumentos) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "credCoreApi00001",
          "name": "Core API - servico_n8n"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000
    },
    {
      "id": "00000000-0000-4000-8000-000000000101",
      "name": "Retorno para o agente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        0
      ],
      "parameters": {
        "jsCode": "// Devolve ao modelo apenas o resultado estruturado (ok/resultado ou ok=false/erro com orientação).\nconst r = $input.first().json;\nif (r && r.erro && r.ok === undefined) return [{ json: { ok: false, erro: { codigo: r.erro.codigo, orientacao: 'Operação recusada pelo sistema. Não invente dados; ofereça atendimento humano.' } } }];\nreturn [{ json: r }];"
      }
    },
