{
  "name": "hotel-agent-core",
  "version": "0.1.0",
  "private": true,
  "description": "Núcleo determinístico do agente de atendimento e reservas hoteleiras via WhatsApp (validação, políticas, ferramentas, integrações). Orquestrado pelo n8n.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:pg": "node --test \"test-pg/**/*.test.js\"",
    "migrate": "node scripts/migrate.js",
    "gen:tools": "node scripts/export-tools.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "pg": "^8.13.1"
  }
}
