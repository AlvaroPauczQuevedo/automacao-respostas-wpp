# =====================================================================================
#  EXEMPLO DE CONFIGURAÇÃO — NÃO CONTÉM SEGREDOS. Copie para .env e preencha.
#  NUNCA versione o .env. Em produção, injete segredos a partir de um cofre (Vault, AWS SM, Azure KV...).
#  Valores marcados PENDENTE dependem de decisão/informação da rede (docs/01-levantamento-requisitos.md).
# =====================================================================================

# ---------- Ambiente ----------
APP_ENV=desenvolvimento            # desenvolvimento | homologacao | producao
PORT=8080
LOG_LEVEL=info
PUBLIC_BASE_URL=                   # URL HTTPS pública do core (página /verificacao). Ex.: https://atendimento.exemplo.com.br

# ---------- Banco ----------
REPO_DRIVER=memory                 # memory (somente dev) | postgres
DATABASE_URL=                      # postgres://usuario:senha@host:5432/hotel_agent  (preencher fora do repositório)
POSTGRES_USER=
POSTGRES_PASSWORD=

# ---------- Criptografia / pseudonimização ----------
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=k1
DATA_ENCRYPTION_OLD_KEYS={}        # {"k0":"<base64>"} durante rotação de chaves
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HASH_PEPPER=

# ---------- Autenticação de serviços e equipe ----------
# Mapa: SHA-256 do token -> papel. Os tokens em claro ficam somente no cofre / credenciais do n8n.
# Gerar hash: node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" "<token>"
# Papéis: servico_n8n | atendente | supervisor | encarregado_dados | admin_tecnico
SERVICE_TOKENS={}

# ---------- WhatsApp Cloud API ----------
WHATSAPP_MODE=mock                 # mock (simulado) | cloud
WHATSAPP_GRAPH_API_VERSION=        # PENDENTE: confirmar a versão vigente na documentação da Meta (ex.: vNN.0)
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=             # token de usuário de sistema (não usar token temporário)
WHATSAPP_APP_SECRET=               # valida X-Hub-Signature-256
WHATSAPP_VERIFY_TOKEN=             # desafio de inscrição do webhook
WHATSAPP_SERVICE_WINDOW_HOURS=24
WHATSAPP_MAX_SEND_PER_SECOND=20
WHATSAPP_MAX_PER_RECIPIENT_PER_MINUTE=8
WEBHOOK_ASSINATURA_OBRIGATORIA=true

# ---------- Integração hoteleira ----------
HOTEL_ADAPTER=mock                 # mock (simulado) | rest (contrato contracts/hotel-integration.openapi.yaml)
HOTEL_API_BASE_URL=
HOTEL_API_TOKEN=
HOTEL_API_TIMEOUT_MS=12000
HOTEL_API_MAX_RETRIES=2

# ---------- Notificações (link de verificação reforçada por e-mail) ----------
NOTIFY_MODE=mock                   # mock | webhook
NOTIFY_EMAIL_WEBHOOK_URL=
NOTIFY_EMAIL_WEBHOOK_TOKEN=

# ---------- Negócio (PENDENTES até validação da rede) ----------
NOME_REDE=                         # PENDENTE
AVISO_PRIVACIDADE_URL=             # PENDENTE — sem ele, novas reservas são encaminhadas a atendentes
CANAL_PRIVACIDADE=                 # PENDENTE — canal do encarregado
HORARIO_ATENDIMENTO=               # PENDENTE — {"fuso":"America/Sao_Paulo","descricao":"de segunda a sexta, das 8h às 20h","dias":{"1":["08:00","20:00"]}}
IDIOMAS_SUPORTADOS=pt-BR
VERIFICACAO_REFORCADA_MODO=atendente   # atendente | link_email
MARKETING_HABILITADO=false         # mensagens promocionais desativadas até decisão formal
FILAS_ATENDIMENTO={}               # {"disputa_cobranca":"financeiro"} (sobrescreve o padrão)
PRAZO_INTERNO_PRIVACIDADE_DIAS=15  # PROVISÓRIO — confirmar com o encarregado

# ---------- Limites operacionais ----------
CONFIRMACAO_TTL_MIN=15
VERIFICACAO_TTL_MIN=30
VERIFICACAO_MAX_FALHAS=3
VERIFICACAO_JANELA_HORAS=24
TURN_LOCK_LEASE_MS=120000
HISTORICO_MENSAGENS_CONTEXTO=12
MAX_TAMANHO_MENSAGEM=2000
MAX_CHAMADAS_FERRAMENTA_TURNO=12
MAX_NOITES_RESERVA=30
MAX_QUARTOS_RESERVA=5
ANTECEDENCIA_MAX_DIAS=540
RECONCILIACAO_APOS_MIN=5
ALERTA_ERROS_POR_HORA=20

# ---------- Retenção (dias) — PROVISÓRIOS até aprovação do encarregado/jurídico ----------
RETENCAO_CONTEUDO_MENSAGENS_DIAS=30
RETENCAO_METADADOS_MENSAGENS_DIAS=180
RETENCAO_EVENTOS_ENTRADA_DIAS=7
RETENCAO_CONVERSAS_INATIVAS_DIAS=365
RETENCAO_DADOS_HOSPEDE_PENDENTES_HORAS=24
RETENCAO_COTACOES_DIAS=90
RETENCAO_AUDITORIA_DIAS=1825

# ---------- n8n (docker-compose) ----------
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_URL=                   # URL pública HTTPS do n8n (ex.: https://n8n.exemplo.com.br/)
